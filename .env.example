# ── Flask ──────────────────────────────────────────────────────
SECRET_KEY=CAMBIA_ESTA_CLAVE_SECRETA_MUY_LARGA
FLASK_ENV=production

# ── Base de datos MySQL (Railway) ──────────────────────────────
# Railway inyecta MYSQL_URL automáticamente si tienes el plugin MySQL.
# También puedes definir DATABASE_URL manualmente:
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/dbname
MYSQL_URL=

# ── Cron — Reporte de salud admin ─────────────────────────────
# Grupo de WhatsApp del admin donde llega el reporte global de cada corrida.
ADMIN_STATUS_API_KEY=
ADMIN_STATUS_GROUP=120363411670493724@g.us

# ── J&T Scraper — configuración global ────────────────────────
JT_HEADLESS=true
JT_CAPTCHA_ATTEMPTS=6
JT_LANG=ES
JT_TIMEZONE=GMT-0500
JT_COUNTRY_ID=1

# Proxy de respaldo Decodo (opcional, anti-baneo por IP)
JT_PROXY_USER=
JT_PROXY_PASS=
JT_PROXY_HOST=gate.decodo.com
JT_PROXY_PORT=10001
